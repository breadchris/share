# Simple Dockerfile that uses pre-built binary
FROM alpine:latest

# Install runtime dependencies
RUN apk --no-cache add ca-certificates git docker-cli curl

# Create app user
RUN addgroup -g 1001 app && \
    adduser -D -s /bin/sh -u 1001 -G app app

# Set working directory
WORKDIR /app

# Copy pre-built binary
COPY worklet .

# Create directories
RUN mkdir -p /tmp/worklet-repos && \
    chown -R app:app /app /tmp/worklet-repos

# Make binary executable
RUN chmod +x worklet

# Expose port
EXPOSE 8080

# Switch to app user
USER app

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Run the application
CMD ["./worklet"]